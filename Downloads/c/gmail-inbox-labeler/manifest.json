{
  "manifest_version": 3,
  "name": "Gmail Inbox Labeler",
  "version": "1.0.0",
  "description": "Adds lightweight per-email labels in Gmail inbox with local persistence.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
